# Etapa 1: Build de Angular
FROM node:20 AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build -- --configuration=production

# Etapa 2: Producción con Nginx
FROM nginx:alpine

# Importante: borrar el contenido default de nginx (incluye el index.html "Welcome to nginx!")
RUN rm -rf /usr/share/nginx/html/*

# Copiar el build real (en tu caso está en /browser)
COPY --from=build /app/dist/cordobacelulares/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
